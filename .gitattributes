# Normalize line endings to LF in the repo and working tree
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Keep dev-only files out of Composer dist archives
/.gitattributes export-ignore
/.gitignore export-ignore
/example export-ignore
/tests export-ignore

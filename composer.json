{
    "name": "joydeep-bhowmik/quire",
    "description": "File-based page router for plain PHP: every .php or .blade.php file is a route, with middleware and named routes.",
    "type": "library",
    "license": "MIT",
    "keywords": ["router", "routing", "file-based", "pages", "middleware", "blade", "folio"],
    "homepage": "https://github.com/joydeep-bhowmik/quire",
    "authors": [
        {
            "name": "Joydeep Bhowmik",
            "email": "bhowmikj9432@gmail.com",
            "homepage": "https://github.com/joydeep-bhowmik"
        }
    ],
    "support": {
        "issues": "https://github.com/joydeep-bhowmik/quire/issues",
        "source": "https://github.com/joydeep-bhowmik/quire"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "illuminate/events": "^13.34",
        "illuminate/view": "^13.34"
    },
    "suggest": {
        "illuminate/view": "Render *.blade.php pages with Quire\\Blade\\BladeRenderer.",
        "illuminate/events": "Required by illuminate/view when using the Blade adapter."
    },
    "autoload": {
        "psr-4": {
            "Quire\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "scripts": {
        "test": "php tests/run.php",
        "serve": "php -S localhost:8000 -t example/public example/public/index.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
